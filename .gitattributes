# What `git archive` (and GitHub's source tarballs) leave out. The release
# packages are built from `git archive` of the tag, so the archive holds only
# what a package build needs. tests/test_packaging.py checks this list.

# Repository plumbing and the test suite.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/tests export-ignore

# Never tracked, but kept out should one be added by mistake: one line per
# .gitignore pattern (same anchoring; a trailing / is dropped, since
# attributes match a folder by its name).
.superpowers export-ignore
__pycache__ export-ignore
*.py[cod] export-ignore
*$py.class export-ignore
.venv export-ignore
venv export-ignore
env export-ignore
.eggs export-ignore
*.egg-info export-ignore
build export-ignore
dist export-ignore
.mypy_cache export-ignore
.ruff_cache export-ignore
.pytest_cache export-ignore
*.qmlc export-ignore
*.jsc export-ignore
.idea export-ignore
.vscode export-ignore
*.swp export-ignore
.DS_Store export-ignore
*.local export-ignore
secrets export-ignore
fixtures/live export-ignore
# Local Claude Code notes, settings and the test lab.
.claude export-ignore
