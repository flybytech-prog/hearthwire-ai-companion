// Generated by app/CMakeLists.txt at configure time (task 012 R4 P2c): the
// About page's values from plasmoid/metadata.json, the .desktop file's
// Comment and the project version. CMake checks every value against a fixed
// character set before writing it here, so none can end the string.
#pragma once

#define HW_ABOUT_VERSION "@PROJECT_VERSION@"
#define HW_ABOUT_COMMENT "@hw_about_comment@"
#define HW_ABOUT_LICENSE "@hw_about_license@"
#define HW_ABOUT_AUTHORS "@hw_about_authors@"
#define HW_ABOUT_AUTHOR_COUNT @hw_authors_count@
#define HW_ABOUT_WEBSITE "@hw_about_website@"
#define HW_ABOUT_BUG_REPORT_URL "@hw_about_bugs@"
