<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<!-- The private session bus of the app's bus tests (task 012 R3), started
     by dbus-run-session for one test and gone with it. Generated by CMake
     from app/tests/dbus-session.conf.in.
     - Listens only on a path socket in the build tree's 0700 bus folder
       (random name, so tests can run in parallel); no abstract socket.
     - EXTERNAL authentication only; with no <allow user> rule the daemon
       accepts connections only from the uid it runs as (the test's).
     - No service folders (<servicedir>, <standard_session_servicedirs/>)
       and no <include>/<includedir>: nothing can be activated or added, so
       no test can start a host service through this bus. -->
<busconfig>
  <type>session</type>
  <listen>unix:dir=@HW_BUS_DIR@</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
    <allow own="*"/>
  </policy>
</busconfig>
